  "validation_notes": {
    "required_fields": [
      "userID (must be valid ObjectId from users collection)",
      "totalItem (must be >= 1)",
      "detail (array with at least 1 item)",
      "deliverAddress (string)"
    ],
    "detail_item_fields": [
      "product (valid ObjectId from products collection)",
      "quantity (min: 1)",
      "size (enum: S, M, L, XL)",
      "color (string, must match product variant)",
      "price (total price for quantity: unitPrice * quantity)"
    ],
    "optional_fields": [
      "shippingPrice (defaults to 0)",
      "taxPrice (defaults to 0)",
      "discount.percent (0-100, defaults to 0)",
      "discount.amount (min: 0, defaults to 0)",
      "coupon (ObjectId reference to Coupon)"
    ],
    "auto_generated_fields": [
      "orderID (format: ORD-00001, ORD-00002, etc.)",
      "trackingNumber (10-character nanoid)",
      "subTotal (calculated from detail prices)",
      "totalPrice (subTotal - discount + shipping + tax)",
      "status.pass (defaults to ['orderPlaced'])",
      "cancel (defaults to false)",
      "createdAt (defaults to current date)"
    ],
    "important_rules": [
      "Cannot use both discount.percent and discount.amount at the same time",
      "If using coupon, make sure the coupon is active and not expired",
      "Product variants (size, color) must exist in the product's variants array",
      "totalItem should match the number of detail items",
      "Price in detail should be unitPrice * quantity"
    ]
  },
  
